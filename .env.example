# ---------------------------------------------------------------------------
# Cairin — contoh berkas lingkungan.
# Salin menjadi .env.local dan isi dengan nilai sungguhan.
# .env.local tidak pernah masuk ke git.
# ---------------------------------------------------------------------------

# Kredensial penerbit IDRX.
# Hanya diberikan kepada akun bisnis yang sudah lolos verifikasi penerbit.
# Tanpa keduanya, halaman pencairan menutup diri dan mengatakannya terus terang
# alih-alih berpura-pura siap.
IDRX_API_KEY=
IDRX_SECRET_KEY=

# RPC. Kosongkan untuk memakai endpoint publik bawaan viem, yang cukup untuk
# pengembangan tetapi punya batas laju. Untuk produksi, isi dengan penyedia
# berbayar supaya pembacaan struk transaksi tidak tersendat saat ramai.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Dipakai untuk membangun URL absolut pada metadata Open Graph.
NEXT_PUBLIC_SITE_URL=https://cairin.vercel.app
